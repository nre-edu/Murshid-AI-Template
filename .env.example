# مرشد — مساعدك المعرفي (Murshid-AI-Template)
# انسخ هذا الملف إلى .env واملأ القيم محليًا. لا ترفع ملف .env إلى GitHub أو Vercel كملف داخل المستودع.

# مفتاح Google Gemini API (أنشئ مفتاحك الخاص من Google AI Studio)
# على Vercel: أضفه من Project → Settings → Environment Variables كمتغير خادم فقط
# بدون بادئات مثل NEXT_PUBLIC_ أو VITE_
GEMINI_API_KEY=

# نموذج Gemini ضمن الطبقة المجانية المناسبة للمشاريع الجديدة (يمكن تغييره)
GEMINI_MODEL=gemini-3.5-flash-lite

# حدود الطلب (اختيارية)
# أقصى طول لسؤال المستخدم بالأحرف
MAX_QUERY_CHARS=2000
# حد تقريبي لعدد الطلبات لكل دقيقة داخل نسخة العملية الواحدة (ليس حماية شاملة على Vercel متعدد النسخ)
RATE_LIMIT_PER_MINUTE=20

# عند التشغيل على نظام ملفات للقراءة فقط (مثل محاكاة Vercel محليًا)
# MURSHID_READONLY=1

# مصدر المعرفة: ملفات .md أو .txt داخل مجلد Knowledge/ في جذر المشروع
# ملفات Knowledge/_examples/ مستبعدة من فهرسة الإجابات
